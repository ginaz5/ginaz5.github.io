# Copy this file to .env.local (which is gitignored) and fill in your values.
# .env.local is sourced by scripts/dev.sh before running `hugo serve`.

# Drive direct-download URL for the resume PDF
HUGO_PARAMS_RESUMEURL=https://drive.google.com/uc?export=download&id=REPLACE_WITH_FILE_ID

# LinkedIn profile URL (used as emergency-redirect target if Drive breaks)
HUGO_PARAMS_LINKEDINURL=https://www.linkedin.com/in/hui-ting-lin-209a93a4/
